{
  "hosting": {
    "public": ".",
    "ignore": [
      "scripts/**",
      ".git/**",
      "firebase.json",
      "**/.*",
      "docs/**",
      "*.png",
      "qa-*/**",
      "node_modules/**",
      ".playwright-mcp/**"
    ],
    "headers": [
      {
        "source": "**/*.@(gltf|bin|png|svg)",
        "headers": [{ "key": "Cache-Control", "value": "public,max-age=31536000,immutable" }]
      },
      {
        "source": "cms/content.json",
        "headers": [{ "key": "Cache-Control", "value": "public,max-age=60" }]
      }
    ]
  }
}
